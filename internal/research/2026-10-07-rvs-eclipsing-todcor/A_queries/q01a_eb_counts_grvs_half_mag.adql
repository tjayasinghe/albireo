SELECT FLOOR(u.grvs / 0.5) AS hbin, COUNT(*) AS n,
       COUNT(u.grvs_mag) AS n_grvs_mag,
       COUNT(u.radial_velocity) AS n_radial_velocity,
       COUNT(u.rv_nb_transits) AS n_rv_nb_transits
FROM (
  SELECT t.x AS x, t.rp AS rp, t.grvs_mag AS grvs_mag, t.radial_velocity AS radial_velocity, t.rv_nb_transits AS rv_nb_transits,
         IF_THEN_ELSE(t.x <= 1.2,
             t.rp + (-0.0397 - 0.2852*t.x - 0.0330*t.x*t.x - 0.0867*t.x*t.x*t.x),
             t.rp + (-4.0618 + 10.0187*t.x - 9.0532*t.x*t.x + 2.6089*t.x*t.x*t.x)) AS grvs
  FROM (
    SELECT g.phot_rp_mean_mag AS rp,
           g.phot_g_mean_mag - g.phot_rp_mean_mag AS x,
           g.grvs_mag AS grvs_mag,
           g.radial_velocity AS radial_velocity,
           g.rv_nb_transits AS rv_nb_transits
    FROM gaiadr3.vari_eclipsing_binary AS v
    JOIN gaiadr3.gaia_source AS g ON g.source_id = v.source_id
  ) AS t
) AS u
WHERE u.x >= -0.15 AND u.x <= 1.7
GROUP BY hbin
ORDER BY hbin
