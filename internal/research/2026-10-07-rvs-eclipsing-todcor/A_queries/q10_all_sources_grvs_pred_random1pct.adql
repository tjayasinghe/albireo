SELECT FLOOR(u.grvs) AS mbin, COUNT(*) AS n, COUNT(u.radial_velocity) AS n_radial_velocity,
       COUNT(u.grvs_mag) AS n_grvs_mag
FROM (
  SELECT t.x AS x, t.radial_velocity AS radial_velocity, t.grvs_mag AS grvs_mag,
         IF_THEN_ELSE(t.x <= 1.2,
             t.rp + (-0.0397 - 0.2852*t.x - 0.0330*t.x*t.x - 0.0867*t.x*t.x*t.x),
             t.rp + (-4.0618 + 10.0187*t.x - 9.0532*t.x*t.x + 2.6089*t.x*t.x*t.x)) AS grvs
  FROM (
    SELECT g.phot_rp_mean_mag AS rp, g.phot_g_mean_mag - g.phot_rp_mean_mag AS x,
           g.radial_velocity AS radial_velocity, g.grvs_mag AS grvs_mag
    FROM gaiadr3.gaia_source AS g
    WHERE g.random_index < 18117098 AND g.phot_rp_mean_mag < 16.7
  ) AS t
) AS u
WHERE u.x >= -0.15 AND u.x <= 1.7 AND u.grvs < 16.0
GROUP BY mbin
ORDER BY mbin
