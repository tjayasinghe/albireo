SELECT n.nss_solution_type, FLOOR(g.phot_g_mean_mag) AS gbin, COUNT(*) AS n
FROM gaiadr3.nss_two_body_orbit AS n
JOIN gaiadr3.vari_eclipsing_binary AS v ON v.source_id = n.source_id
JOIN gaiadr3.gaia_source AS g ON g.source_id = n.source_id
GROUP BY n.nss_solution_type, gbin
ORDER BY n.nss_solution_type, gbin
